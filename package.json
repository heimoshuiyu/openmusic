{
  "name": "openmusic",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@openmusic/server' dev",
    "dev:web": "bun run --filter '@openmusic/web' dev",
    "tui": "bun apps/tui/src/index.tsx",
    "test": "bun test",
    "test:unit": "bun test apps/server/src apps/web/test",
    "test:integration": "bun test apps/server/test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage",
    "check": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "db:up": "podman compose up -d db",
    "db:down": "podman compose down"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@opencode/ai": "file:vendor/opencode/ai-2.2.5-openmusic.1-3c99f07ae256.tgz",
    "@opencode/client": "file:vendor/opencode/client-2.2.5-openmusic.1-4262522b6214.tgz",
    "@opencode/codemode": "file:vendor/opencode/codemode-2.2.5-openmusic.1-f4a2c769315e.tgz",
    "@opencode/core": "file:vendor/opencode/core-2.2.5-openmusic.1-0f3e1ae3af3a.tgz",
    "@opencode/plugin": "file:vendor/opencode/plugin-2.2.5-openmusic.1-14fd46487bc2.tgz",
    "@opencode/plugin-browser": "file:vendor/opencode/plugin-browser-2.2.5-openmusic.1-5a7ee14ed9a5.tgz",
    "@opencode/protocol": "file:vendor/opencode/protocol-2.2.5-openmusic.1-8ce510cef26f.tgz",
    "@opencode/schema": "file:vendor/opencode/schema-2.2.5-openmusic.1-8a0f27faee1a.tgz",
    "@opencode/sdk": "file:vendor/opencode/sdk-2.2.5-openmusic.1-d3b38bb8c55d.tgz",
    "@opencode/server": "file:vendor/opencode/server-2.2.5-openmusic.1-9b2be6c05699.tgz",
    "@opencode/simulation": "file:vendor/opencode/simulation-2.2.5-openmusic.1-161f1d3283c1.tgz",
