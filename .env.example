# OpenMusic 环境变量示例（复制为 .env 后按需修改）

# HTTP
PORT=3000
HOST=0.0.0.0

# 为新库生成密码（例如 openssl rand -hex 24），填到以下两处。Compose DSN 使用 URL 安全字符。
POSTGRES_PASSWORD=
DATABASE_URL=
# DATABASE_URL=postgres://openmusic:<your-hex-password>@127.0.0.1:5433/openmusic

# 数据目录（封面等，git 忽略）
DATA_DIR=./data

# 转码缓存（放 /tmp，重启即清）
TRANSCODE_CACHE_DIR=/tmp/openmusic/transcode
TRANSCODE_CACHE_MAX_BYTES=5368709120
TRANSCODE_MAX_CONCURRENCY=4

# 封面缓存上限（DATA_DIR/covers，与转码缓存共用 LRU 淘汰器）
COVERS_CACHE_MAX_BYTES=536870912

# AI agent（docs/08-ai-agent.md）：默认关。开启前置好独立配置文件
#（默认 <DATA_DIR>/agent-config.json，OpenCode config JSON：model/providers/agents）
AGENT_ENABLED=false
# AGENT_CONFIG=/path/to/agent-config.json

# 日志
LOG_LEVEL=info

# 首次启动管理员引导（仅当 users 表为空时生效）
# OPENMUSIC_ADMIN_USER=admin
# OPENMUSIC_ADMIN_PASSWORD=        # 设了但短于 6 位会被忽略并改用随机密码（打印在启动日志）

# Subsonic/会话凭据加密密钥（≥16 字符）。留空则首启生成 DATA_DIR/secret.key（务必备份，见 docs/07）
# OPENMUSIC_SECRET=

# 首启音乐文件夹种子（逗号分隔绝对路径；之后以 API 管理为准）
# MUSIC_FOLDERS=/path/to/music

# Bun.serve 空闲连接超时秒数（0=禁用）。默认 0，勿动——流式播放依赖长连接（docs/07 §7）
# SERVER_IDLE_TIMEOUT=0

# YouTube 导入写标签用的 python 解释器（需可 import mutagen；容器内已内置，无需设置）
# OPENMUSIC_TAG_PYTHON=python3
